# Neon Lakebase Postgres Connection Strings (Server-only)
# Pooled connection for application runtime traffic
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection for Drizzle Kit schema migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Centralized Public Configuration
# Qatar WhatsApp number (format: 974XXXXXXXX - digits only, no +, spaces, or dashes)
NEXT_PUBLIC_WHATSAPP_NUMBER="97400000000"
NEXT_PUBLIC_SITE_URL="https://vistaracleaning.qa"
NEXT_PUBLIC_GOOGLE_REVIEW_URL=""

# Server-Only Admin Email (Resend) for Forgot/Reset Password
RESEND_API_KEY=""
EMAIL_FROM="Vistara Admin <noreply@vistaracleaning.qa>"
APP_URL="http://localhost:3000"

# Server-Only Cloud Image Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Server-Only AI Image Generation Adapter (openai | gemini)
IMAGE_GENERATION_PROVIDER=""
IMAGE_GENERATION_API_KEY=""

# Optional CLI Initial SUPER_ADMIN Bootstrap (`pnpm db:seed-admin`)
