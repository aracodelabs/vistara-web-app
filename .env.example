# Neon Lakebase Postgres Connection Strings
# Pooled connection for application runtime traffic
DATABASE_URL="postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection for Drizzle Kit schema migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Centralized WhatsApp Configuration (Qatar format: 974XXXXXXXX - digits only, no +, spaces, or dashes)
NEXT_PUBLIC_WHATSAPP_NUMBER="97400000000"

# Canonical site URL for SEO metadata, sitemaps, and Open Graph
NEXT_PUBLIC_SITE_URL="https://vistaracleaning.qa"

# Optional genuine Google Business Profile review URL (leave blank until live)
NEXT_PUBLIC_GOOGLE_REVIEW_URL=""
